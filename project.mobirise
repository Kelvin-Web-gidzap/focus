          "_customHTML": "<section class=\"content8\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    \n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n        <input type=\"range\" inline name=\"imgWidth\" title=\"Image Width\" min=\"4\" max=\"12\" value=\"6\" step=\"1\">\n        <header>Card Settings</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showSecondTitle\" checked> \n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSecondSubtitle\" checked> \n           <input type=\"checkbox\" title=\"Show Buttons\" name=\"showSecondButtons\">\n        <input type=\"color\" title=\"Background Color\" name=\"secondBg\" value=\"#ffd800\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/bg_3.jpg\" parallax> \n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=2jqUN6d6ZyM\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg_1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse': reverseContent}\"> \n            \n            <div class=\"card first-card col-12 col-lg-{{imgWidth}}\">\n                <div class=\"card-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/%D0%A1%D0%BD%D0%B8%D0%BC%D0%BE%D0%BA%20%D1%8D%D0%BA%D1%80%D0%B0%D0%BD%D0%B0%202025-02-10%20%D0%B2%2011.06.08-948x1064.png\" alt=\"Клиенты получают товар в транспортной\">\n                </div>\n            </div>\n\n            <div class=\"card second-card col-12 col-lg-{{12-imgWidth}} align-center\" mbr-if=\"showSecondTitle || showSecondSubtitle || showSecondButtons\">\n                        <div class=\"second-card-wrap\">\n                         <h1 class=\"second-card-title mbr-fonts-style mb-0 mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showSecondTitle\" data-app-selector=\".second-card-title\">Получение товара в ТК</h1>\n                     <h3 class=\"second-card-subtitle mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSecondSubtitle\" data-app-selector=\".second-card-subtitle, .second-btn\">Вам не нужно арендовать офис или склад для выдачи товаров, клиенты получают заказы в транспортной компании своего города.</h3>\n                    <div class=\"mbr-section-btn second-btn mb-0 mt-4\" mbr-if=\"showSecondButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-black\" href=\"popup:#mbr-popup-5\" data-app-placeholder=\"Введите Текст\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-5\" data-bs-target=\"#mbr-popup-5\">Подключиться</a></div>\n                </div>\n              </div>       \n        </div>\n    </div>\n</section>",
