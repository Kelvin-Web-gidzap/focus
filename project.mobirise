            },
            ".second-card-subtitle, .second-btn": {
              "text-align": "center",
              "color": "#000000"
            },
            ".card": {
              "border-radius": "0 !important"
            }
          },
          "_name": "content3",
          "_sourceTheme": "claimm4",
          "_customHTML": "<section class=\"content3\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\" checked>\n        <input type=\"range\" inline name=\"textWidth\" title=\"Text Width\" min=\"4\" max=\"12\" value=\"6\" step=\"1\">\n        <header>First Card Settings</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showFirstTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showFirstText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Background Color\" name=\"firstBg\" value=\"#ffffff\">\n        <header>Second Card Settings</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showSecondTitle\" checked> \n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSecondSubtitle\" checked> \n           <input type=\"checkbox\" title=\"Show Buttons\" name=\"showSecondButtons\" checked>\n        <input type=\"color\" title=\"Background Color\" name=\"secondBg\" value=\"#ffd800\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@THEME_PATH@/components/_images/bg_3.jpg\" parallax> \n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=2jqUN6d6ZyM\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse': reverseContent}\"> \n            \n            <div class=\"card first-card col-12 col-lg-{{textWidth}}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/closeup-businessmen-shaking-hands-after-successful-agreement-1250x833.jpg\" alt=\"Работа по договору Gidzap\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showFirstTitle || showFirstText || showButtons\">\n                        <h2 class=\"first-card-title mbr-fonts-style mb-0 mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showFirstTitle\" data-app-selector=\".first-card-title\">Работаем с гaрантией полyчения зaказов, официaльно пo догoвору.</h2>\n                        <p class=\"mbr-text mbr-fonts-style mb-0 mt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showFirstText\" data-app-selector=\".mbr-text, .card-btn\">Опираясь на наш опыт, мы подключаем все необходимые маркетинговые инструменты для ежедневного получения заказов.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn card-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"https://mobiri.se\" class=\"btn btn-md btn-primary\" data-app-placeholder=\"Type Text\">\n                               Login Now\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card second-card col-12 col-lg-{{12-textWidth}} align-center\" mbr-if=\"showSecondTitle || howSecondSubtitle || showSecondButtons\">\n                        <div class=\"second-card-wrap\">\n                         <h1 class=\"second-card-title mbr-fonts-style mb-0 mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showSecondTitle\" data-app-selector=\".second-card-title\">Прибыль в месяц</h1>\n                     <h3 class=\"second-card-subtitle mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showSecondSubtitle\" data-app-selector=\".second-card-subtitle, .second-btn\"><b>от 100 000 ₽&nbsp;</b></h3>\n                    <div class=\"mbr-section-btn second-btn mb-0 mt-4\" mbr-if=\"showSecondButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-black\" href=\"popup:#mbr-popup-5\" data-app-placeholder=\"Введите Текст\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#mbr-popup-5\" data-bs-target=\"#mbr-popup-5\">Начать зарабатывать</a></div>\n                </div>\n              </div>       \n        </div>\n    </div>\n</section>",
