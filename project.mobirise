          "_name": "features6",
          "_sourceTheme": "claimm4",
          "_customHTML": "<section class=\"features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n         <input type=\"checkbox\" title=\"Footer\" name=\"showFooter\">\n        <select title=\"Footer Align\" name=\"footerAlign\" condition=\"showFooter\">\n            <option value=\"center\" selected>Center</option>\n            <option value=\"start\">Left</option>\n            <option value=\"end\">Right</option>\n        </select>\n        <header>Card</header>\n         <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card 1 Color\" name=\"Color1\" value=\"#ffffff\" selected condition=\"cardsAmount > 0\">\n                <input type=\"color\" title=\"Card 2 Color\" name=\"Color2\" value=\"#ffffff\" selected condition=\"cardsAmount > 1\">\n                <input type=\"color\" title=\"Card 3 Color\" name=\"Color3\" value=\"#bcd9df\" selected condition=\"cardsAmount > 2\">\n                <input type=\"color\" title=\"Card 4 Color\" name=\"Color4\" value=\"#419e8e\" selected condition=\"cardsAmount > 3\">\n       \n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/bg_3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/bg_1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            \n            <div class=\"col-12 pb-5\" mbr-if=\"showMainTitle\">\n                <h2 class=\"mbr-section-title mbr-fonts-style align-center  mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    Кому подойдет бизнес?</h2>\n            </div>\n            \n            <div class=\"card\" mbr-if=\"cardsAmount > 0\" mbr-class=\"\n      {'col-12 col-md-8 col-lg-8': cardsAmount == 1,\n       'col-12 col-md-6 col-lg-6': cardsAmount == 2,\n       'col-12 col-md-6 col-lg-4': cardsAmount == 3,\n       'col-12 col-md-6': cardsAmount == 4}\">\n                <div class=\"card-wrapper card-wrapper-1\">\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-title mbr-fonts-style  mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Новичкам</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">Для тех кто хочет открыть бизнес, но не знает с чего начать и не имеет опыта в продажах через маркетплейсы.</p>\n                                            <div class=\"mbr-section-btn second-btn mb-0 mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Contact Us</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card\" mbr-class=\"\n      {'col-12 col-md-6': cardsAmount == 2,\n       'col-12 col-md-6 col-lg-4': cardsAmount == 3,\n       'col-12 col-md-6 col-lg-6': cardsAmount == 4}\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper card-wrapper-2\">\n                    <div class=\"card-box align-left\">\n                         <h5 class=\"card-title mbr-fonts-style  mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Опытным продавцам</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">Для тех кто уже имеет опыт в данной сфере и хочет масштабировать бизнес в разных городах.</p>\n                                            <div class=\"mbr-section-btn second-btn mb-0 mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Contact Us</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card\" mbr-class=\"\n      {'col-12 col-md-6 col-lg-4': cardsAmount == 3,\n       'col-12 col-md-6 col-lg-6': cardsAmount == 4}\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper card-wrapper-3\">\n                   <div class=\"card-box align-left\">\n                        <h5 class=\"card-title mbr-fonts-style  mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Инвестору</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">Curabitur id nulla vitae finibus ultricies. Sed gravida metus\n                            vestibulum tortor.</p>\n                                           <div class=\"mbr-section-btn second-btn mb-0 mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn more</a></div>\n                    </div>\n                        </div>\n            </div>\n            <div class=\"card\" mbr-class=\"\n      {'col-12 col-md-6 col-lg-6': cardsAmount == 4}\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper card-wrapper-4\">\n                    <div class=\"card-box align-left\">\n                        <h5 class=\"card-title mbr-fonts-style  mbr-bold\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Relations</h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">Curabitur id nulla vitae finibus ultricies. Sed gravida metus\n                            vestibulum tortor.</p>\n                                            <div class=\"mbr-section-btn second-btn mb-0 mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn more</a></div>\n\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"col-md-10 button-section media-container-row justify-content-{{footerAlign}}\" mbr-if=\"showFooter\">\n           <p class=\"section-text mbr-fonts-style  mbr-bold mb-0 mr-1\" mbr-theme-style=\"display-4\" data-app-selector=\".section-text\"> To know the details</p>\n                <div class=\"mbr-section-btn second-btn mbr-bold mb-0\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\" data-app-selector=\".button-section\"><a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">log in and see your repair status</a></div>\n            </div>\n            \n        </div>\n    </div>\n</section>",
          "_cid": "udX6yprNGj",
          "_anchor": "features6-1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-directiion": "row-reverse"
              }
            },
            ".card-wrapper": {
              "width": "100%",
              "height": "100%",
              "img": {
                "height": "600px",
                "object-fit": "cover"
              }
            },
            ".second-card-title": {
              "text-align": "center",
              "color": "#000000"
            },
            ".second-card-subtitle": {
              "text-align": "center"
            },
            ".second-card": {
              "background-color": "@secondBg"
            },
            ".second-card-wrap": {
              "margin": "auto 0",
              "padding": "3rem 1.5rem"
            },
            "@media (min-width: 992px)": {
              "[class*=\"col\"]": {
                "padding-left": "0 !important",
                "padding-right": "0 !important"
              }
            },
            ".second-card-subtitle, .second-btn": {
              "text-align": "center",
              "color": "#000000"
            },
            ".card": {
              "border-radius": "0 !important"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
