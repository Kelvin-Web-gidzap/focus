        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-directiion": "row-reverse"
              }
            },
            ".first-card": {
              "background-color": "@firstBg"
            },
            ".card-box": {
              "padding": "1.5rem 1rem 0 1rem"
            },
            ".second-card-title": {
              "text-align": "center",
              "color": "#000000"
            },
            ".second-card-subtitle": {
              "text-align": "center"
            },
            ".second-card": {
              "background-color": "@secondBg"
            },
            ".second-card-wrap": {
              "margin": "auto 0",
              "padding": "3rem 1.5rem"
            },
            "@media (min-width: 992px)": {
              "[class*=\"col\"]": {
                "padding-left": "0 !important",
                "padding-right": "0 !important"
              }
            },
            "& when not (@showFirstTitle) and not (@showFirstText) and not (@showButtons)": {
              ".card-img": {
                "height": "100%",
                "img": {
                  "height": "100%"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".card-wrapper": {
                "padding-bottom": "3rem",
                "text-align": "center"
              }
            },
            ".first-card-title": {
              "text-align": "left",
              "color": "#000000"
